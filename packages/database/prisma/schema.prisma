generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  subdomain String?  @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  patients     Patient[]
  dietPlans    DietPlan[]
  appointments Appointment[]
  recipes      Recipe[]
}

enum Role {
  ADMIN
  NUTRITIONIST
}

model User {
  id        String   @id @default(uuid())
  tenantId  String
  email     String   @unique
  name      String?
  role      Role     @default(NUTRITIONIST)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  appointments Appointment[]
  dietPlans    DietPlan[]
  conversations Conversation[]
}

model Patient {
  id        String   @id @default(uuid())
  tenantId  String
  firstName String
  lastName  String
  email     String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  anamnesis    Anamnesis[]
  metrics      Metric[]
  dietPlans    DietPlan[]
  appointments Appointment[]
  shoppingLists ShoppingList[]
  conversations Conversation[]
}

model Anamnesis {
  id        String   @id @default(uuid())
  patientId String
  data      Json
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id])
}

model Metric {
  id                String   @id @default(uuid())
  patientId         String
  weight            Float
  bodyFatPercentage Float?
  muscleMass        Float?
  perimeters        Json?
  date              DateTime @default(now())
  createdAt         DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id])
}

model DietPlan {
  id             String    @id @default(uuid())
  tenantId       String
  patientId      String
  nutritionistId String
  targetKcal     Float?
  targetMacros   Json?
  startDate      DateTime
  endDate        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant       Tenant  @relation(fields: [tenantId], references: [id])
  patient      Patient @relation(fields: [patientId], references: [id])
  nutritionist User    @relation(fields: [nutritionistId], references: [id])
  meals        Meal[]
  shoppingLists ShoppingList[]
}

model Appointment {
  id             String   @id @default(uuid())
  tenantId       String
  patientId      String
  nutritionistId String
  date           DateTime
  status         String   @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant       Tenant  @relation(fields: [tenantId], references: [id])
  patient      Patient @relation(fields: [patientId], references: [id])
  nutritionist User    @relation(fields: [nutritionistId], references: [id])
}

model Meal {
  id         String   @id @default(uuid())
  dietPlanId String
  type       String // Breakfast, Lunch, Dinner, Snack
  dayOfWeek  Int // 1-7
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  dietPlan  DietPlan   @relation(fields: [dietPlanId], references: [id])
  mealItems MealItem[]
}

model MealItem {
  id            String   @id @default(uuid())
  mealId        String
  foodSource    String // bedca_123, fatsecret_456
  quantityGrams Float
  originalFoodSource String? // For food swapping tracking
  isSwapped     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  meal Meal @relation(fields: [mealId], references: [id])
}

// --- PHASE 1 MODELS ---

model ShoppingList {
  id          String   @id @default(uuid())
  patientId   String
  dietPlanId  String
  weekNumber  Int      // e.g. 1
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  patient     Patient        @relation(fields: [patientId], references: [id])
  dietPlan    DietPlan       @relation(fields: [dietPlanId], references: [id])
  items       ShoppingItem[]
}

model ShoppingItem {
  id             String       @id @default(uuid())
  shoppingListId String
  foodName       String
  quantity       Float
  unit           String       @default("g")
  category       String?      // e.g. "Carnes", "Verduras"
  isChecked      Boolean      @default(false)
  
  shoppingList   ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)
}

model Conversation {
  id             String    @id @default(uuid())
  tenantId       String
  patientId      String
  nutritionistId String
  lastMessageAt  DateTime  @default(now())

  patient      Patient   @relation(fields: [patientId], references: [id])
  nutritionist User      @relation(fields: [nutritionistId], references: [id])
  messages     Message[]

  @@unique([patientId, nutritionistId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String       // ID of User or Patient
  senderType     String       // "NUTRITIONIST" or "PATIENT"
  content        String       
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model Recipe {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  ingredients Json
  instructions Json?
  prepTime    Int?
  cookTime    Int?
  servings    Int?
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id])
}
